generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid(2))
  email              String              @unique
  name               String?
  image              String?
  passwordHash       String?
  emailVerified      Boolean             @default(false)
  provider           String?
  providerId         String?
  defaultOrgId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  organizationsOwned Organization[]
  organizations      UserOrganization[]
  dietaryPreferences DietaryPreference[]
  chatConversations  ChatConversation[]
  recipeSuggestions  RecipeSuggestion[]
  recipeRatings      RecipeRating[]
  favoriteRecipes    RecipeFavorite[]
  mealPlans          MealPlan[]
  Recipe             Recipe[]
  GroceryList        GroceryList[]
  jobs               Job[]
  apiKeys            ApiKey[]

  @@index([email, id])
  @@index([deletedAt])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(cuid(2))
  name       String // Friendly name for the API key
  keyHash    String    @unique // Hashed API key
  keyPrefix  String // First 8 chars for identification
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime? // Optional expiration
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([userId])
  @@index([keyHash])
  @@index([deletedAt])
  @@map("api_keys")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}

model Organization {
  id             String    @id @default(cuid(2))
  name           String
  slug           String    @unique
  logo           String?
  description    String?
  subscriptionId String?   @unique
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  members      UserOrganization[]
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id])
  recipes      Recipe[]
  lists        GroceryList[]
  jobs         Job[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model UserOrganization {
  id        String       @id @default(cuid(2))
  userId    String
  orgId     String
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([deletedAt])
  @@map("user_organizations")
}

model Subscription {
  id                     String             @id @default(cuid(2))
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  maxRecipes             Int                @default(12)
  maxUsers               Int                @default(1)
  maxLists               Int                @default(5)
  aiCreditsLimit         Int                @default(100)
  aiCreditsUsed          Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  organization           Organization?

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([deletedAt])
  @@map("subscriptions")
}

model Job {
  id           String        @id @default(cuid(2))
  bullJobId    String?       @unique
  type         JobType
  status       JobStatus     @default(QUEUED)
  progress     Int           @default(0)
  jobData      Json?
  resultData   Json?
  errorData    Json?
  metadata     Json?
  userId       String?
  orgId        String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  failedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([id, type, status])
  @@index([id, type])
  @@index([userId])
  @@index([orgId])
  @@index([type])
  @@index([status])
  @@index([bullJobId])
  @@index([createdAt])
  @@map("jobs")
}

// ============================================
// RECIPE MODELS
// ============================================

model Recipe {
  id                 String            @id @default(cuid(2))
  slug               String            @unique
  title              String?
  shortTitle         String?
  description        String?
  tagline            String?
  imageUrl           String? //
  cookTime           Int?
  servings           Int?
  difficulty         RecipeDifficulty?
  cookingSteps       Json? // Array of steps
  ingredients        Json?
  notes              String?
  sourceMetadata     Json?
  sourceType         RecipeSourceType  @default(MANUAL)
  sourceUrl          String?
  sourceName         String?
  sourceVideoUrl     String?
  sourceThumbnailUrl String?
  calories           Int?
  protein            Decimal?          @db.Decimal(10, 2)
  carbs              Decimal?          @db.Decimal(10, 2)
  fat                Decimal?          @db.Decimal(10, 2)
  metadata           Json?

  userId String?
  orgId  String?

  isPublic         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization     Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  tags             RecipeTag[]
  listItems        ListItem[]
  RecipeIngredient RecipeIngredient[]
  RecipeRating     RecipeRating[]
  RecipeFavorite   RecipeFavorite[]
  RecipeSuggestion RecipeSuggestion[]
  MealPlanRecipe   MealPlanRecipe[]

  @@index([userId])
  @@index([orgId])
  @@index([sourceType])
  @@index([isPublic])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recipes")
}

model Ingredient {
  id          String              @id @default(cuid(2))
  slug        String              @unique
  name        String              @unique
  category    IngredientCategory?
  calories    Int?
  protein     Decimal?            @db.Decimal(10, 2)
  carbs       Decimal?            @db.Decimal(10, 2)
  fat         Decimal?            @db.Decimal(10, 2)
  commonUnits Json? // Array of common units like "cup", "tbsp", "g"
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  recipes     RecipeIngredient[]
  listItems   ListItem[]

  @@index([name])
  @@index([category])
  @@index([deletedAt])
  @@map("ingredients")
}

model RecipeIngredient {
  id           String     @id @default(cuid(2))
  recipeId     String
  ingredientId String
  amount       Decimal?   @db.Decimal(10, 2)
  unit         String? // "cup", "tbsp", "g", etc.
  preparation  String? // "chopped", "diced", "minced"
  optional     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([deletedAt])
  @@map("recipe_ingredients")
}

// Reusable tags that can be shared across recipes
model Tag {
  id        String      @id @default(cuid(2))
  slug      String      @unique
  name      String      @unique // "vegetarian", "keto", "italian", "dinner", etc.
  type      TagType     @default(CUSTOM)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  recipes   RecipeTag[] // Many-to-many relationship

  @@index([name])
  @@index([type])
  @@index([deletedAt])
  @@map("tags")
}

// Junction table for many-to-many relationship between Recipe and Tag
model RecipeTag {
  id        String    @id @default(cuid(2))
  recipeId  String
  tagId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tagId])
  @@index([recipeId])
  @@index([tagId])
  @@index([deletedAt])
  @@map("recipe_tags")
}

model RecipeRating {
  id        String    @id @default(cuid(2))
  recipeId  String
  userId    String
  rating    Int // 1-5
  review    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([rating])
  @@index([deletedAt])
  @@map("recipe_ratings")
}

model RecipeFavorite {
  id        String    @id @default(cuid(2))
  recipeId  String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([deletedAt])
  @@map("recipe_favorites")
}

model GroceryList {
  id           String        @id @default(cuid(2))
  name         String
  description  String?
  userId       String
  orgId        String?
  completed    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  items        ListItem[]

  @@index([userId])
  @@index([orgId])
  @@index([completed])
  @@index([deletedAt])
  @@map("grocery_lists")
}

model ListItem {
  id           String              @id @default(cuid(2))
  listId       String
  ingredientId String?
  recipeId     String? // Track which recipe this came from
  name         String // In case ingredient doesn't exist
  amount       Decimal?            @db.Decimal(10, 2)
  unit         String?
  category     IngredientCategory?
  checked      Boolean             @default(false)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  list         GroceryList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe       Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([ingredientId])
  @@index([recipeId])
  @@index([checked])
  @@index([deletedAt])
  @@map("list_items")
}

model AiUsage {
  id           String   @id @default(cuid(2))
  feature      String
  initiator    String
  provider     String
  model        String
  inputTokens  Float    @default(0) @map("input_tokens")
  outputTokens Float    @default(0) @map("output_tokens")
  userId       String   @map("user_id")
  recipeId     String?  @map("recipe_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([recipeId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([provider, model])
  @@map("ai_usages")
}

model DietaryPreference {
  id          String    @id @default(cuid(2))
  userId      String
  type        DietType
  allergens   Json? // Array of allergen strings
  dislikes    Json? // Array of disliked ingredients
  preferences Json? // Additional custom preferences
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([deletedAt])
  @@map("dietary_preferences")
}

model ChatConversation {
  id        String        @id @default(cuid(2))
  userId    String
  title     String?
  recipeId  String? // If chat is about a specific recipe
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@index([recipeId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid(2))
  conversationId String
  role           ChatRole
  content        String           @db.Text
  model          String? // AI model used
  tokens         Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("chat_messages")
}

model RecipeSuggestion {
  id        String    @id @default(cuid(2))
  userId    String
  recipeId  String
  reason    String? // Why this was suggested
  date      DateTime  @default(now())
  viewed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([date])
  @@index([viewed])
  @@index([deletedAt])
  @@map("recipe_suggestions")
}

model MealPlan {
  id        String           @id @default(cuid(2))
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes   MealPlanRecipe[]

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("meal_plans")
}

model MealPlanRecipe {
  id         String    @id @default(cuid(2))
  mealPlanId String
  recipeId   String
  date       DateTime
  mealType   MealType  @default(DINNER)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([recipeId])
  @@index([date])
  @@index([mealType])
  @@index([deletedAt])
  @@map("meal_plan_recipes")
}

// ============================================
// ENUMS
// ============================================

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  PAUSED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeSourceType {
  MANUAL
  INSTAGRAM_REEL
  INSTAGRAM_POST
  INSTAGRAM_VIDEO
  TIKTOK
}

enum IngredientCategory {
  PRODUCE
  MEAT
  SEAFOOD
  DAIRY
  BAKERY
  PANTRY
  SPICES
  CONDIMENTS
  FROZEN
  BEVERAGES
  OTHER
}

enum TagType {
  CUISINE // Italian, Mexican, Asian, etc.
  MEAL_TYPE // Breakfast, Lunch, Dinner, Snack, Dessert
  DIET // Vegetarian, Vegan, Keto, Paleo, etc.
  SEASON // Summer, Winter, Fall, Spring
  OCCASION // Holiday, Party, Quick, Comfort
  CUSTOM // User-defined tags
}

enum DietType {
  VEGETARIAN
  VEGAN
  KETO
  PALEO
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  LOW_CARB
  LOW_FAT
  HALAL
  KOSHER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
}

enum JobType {
  RECIPE_GENERATION
}

enum JobStatus {
  QUEUED
  PENDING // Job created but not started
  RUNNING // Job is currently being processed
  COMPLETED // Job finished successfully
  FAILED // Job failed with error
  CANCELLED // Job was cancelled by user or system
  PAUSED // Job is temporarily paused
}
