generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid(2))
  email              String              @unique
  name               String?
  image              String?
  emailVerified      Boolean             @default(false)
  isAdmin            Boolean             @default(false)
  defaultOrgId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  organizationsOwned Organization[]
  organizations      UserOrganization[]
  dietaryPreferences DietaryPreference[]
  chatConversations  ChatConversation[]
  recipeSuggestions  RecipeSuggestion[]
  recipeRatings      RecipeRating[]
  favoriteRecipes    RecipeFavorite[]
  mealPlans          MealPlan[]
  Recipe             Recipe[]
  GroceryList        GroceryList[]
  jobs               Job[]
  apiKeys            ApiKey[]
  places             Place[]
  products           Product[]
  placeFavorites     PlaceFavorite[]
  productFavorites   ProductFavorite[]

  @@index([email, id])
  @@index([deletedAt])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(cuid(2))
  name       String // Friendly name for the API key
  keyHash    String    @unique // Hashed API key
  keyPrefix  String // First 8 chars for identification
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime? // Optional expiration
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([userId])
  @@index([keyHash])
  @@index([deletedAt])
  @@map("api_keys")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}

model Organization {
  id             String    @id @default(cuid(2))
  name           String
  slug           String    @unique
  description    String?
  subscriptionId String?   @unique
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  members      UserOrganization[]
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id])
  recipes      Recipe[]
  lists        GroceryList[]
  jobs         Job[]
  places       Place[]
  products     Product[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model UserOrganization {
  id        String       @id @default(cuid(2))
  userId    String
  orgId     String
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([deletedAt])
  @@map("user_organizations")
}

model Subscription {
  id                     String             @id @default(cuid(2))
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  razorpaySubscriptionId String?            @unique
  razorpayCustomerId     String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  paymentMethodLast4     String?
  paymentMethodType      String?
  paymentMethodBrand     String?
  chargeAt               DateTime?
  paidCount              Int?
  remainingCount         Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  organization           Organization?
  invoices               Invoice[]

  @@index([deletedAt])
  @@map("subscriptions")
}

model Invoice {
  id                String       @id @default(cuid(2))
  subscriptionId    String
  razorpayPaymentId String       @unique
  razorpayOrderId   String?
  razorpayInvoiceId String?
  amount            Int
  currency          String       @default("INR")
  status            String
  method            String?
  // Card details
  cardLast4         String?
  cardNetwork       String?
  cardIssuer        String?
  cardSubType       String?
  cardInternational Boolean?
  // UPI
  upiVpa            String?
  // Netbanking
  bankCode          String?
  bankTransactionId String?
  // Wallet
  wallet            String?
  // Fees
  fee               Int?
  tax               Int?
  // Error info
  errorCode         String?
  errorDescription  String?
  // Acquirer data
  acquirerData      Json?
  description       String?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([method])
  @@map("invoices")
}

model Job {
  id           String        @id @default(cuid(2))
  bullJobId    String?       @unique
  type         JobType
  status       JobStatus     @default(QUEUED)
  progress     Int           @default(0)
  jobData      Json?
  resultData   Json?
  errorData    Json?
  metadata     Json?
  userId       String?
  orgId        String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  failedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([id, type, status])
  @@index([id, type])
  @@index([userId])
  @@index([orgId])
  @@index([type])
  @@index([status])
  @@index([bullJobId])
  @@index([createdAt])
  @@map("jobs")
}

// ============================================
// RECIPE MODELS
// ============================================

model Recipe {
  id                 String            @id @default(cuid(2))
  slug               String            @unique
  title              String?
  shortTitle         String?
  description        String?
  tagline            String?
  imageUrl           String? //
  cookTime           Int?
  servings           Int?
  difficulty         RecipeDifficulty?
  cookingSteps       Json? // Array of steps
  ingredients        Json?
  notes              String?
  sourceMetadata     Json?
  sourceType         RecipeSourceType  @default(MANUAL)
  sourceUrl          String?
  sourceName         String?
  sourceVideoUrl     String?
  sourceThumbnailUrl String?
  calories           Int?
  protein            Decimal?          @db.Decimal(10, 2)
  carbs              Decimal?          @db.Decimal(10, 2)
  fat                Decimal?          @db.Decimal(10, 2)
  metadata           Json?

  userId String?
  orgId  String?

  isPublic          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  tags              RecipeTag[]
  listItems         ListItem[]
  RecipeIngredient  RecipeIngredient[]
  RecipeRating      RecipeRating[]
  RecipeFavorite    RecipeFavorite[]
  RecipeSuggestion  RecipeSuggestion[]
  MealPlanRecipe    MealPlanRecipe[]
  chatConversations ChatConversation[]

  @@index([userId])
  @@index([orgId])
  @@index([sourceType])
  @@index([isPublic])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recipes")
}

model Ingredient {
  id          String              @id @default(cuid(2))
  slug        String              @unique
  name        String              @unique
  category    IngredientCategory?
  calories    Int?
  protein     Decimal?            @db.Decimal(10, 2)
  carbs       Decimal?            @db.Decimal(10, 2)
  fat         Decimal?            @db.Decimal(10, 2)
  commonUnits Json? // Array of common units like "cup", "tbsp", "g"
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  recipes     RecipeIngredient[]
  listItems   ListItem[]

  @@index([name])
  @@index([category])
  @@index([deletedAt])
  @@map("ingredients")
}

model RecipeIngredient {
  id           String     @id @default(cuid(2))
  recipeId     String
  ingredientId String
  amount       Decimal?   @db.Decimal(10, 2)
  unit         String? // "cup", "tbsp", "g", etc.
  preparation  String? // "chopped", "diced", "minced"
  optional     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([deletedAt])
  @@map("recipe_ingredients")
}

// Reusable tags that can be shared across recipes
model Tag {
  id        String       @id @default(cuid(2))
  slug      String       @unique
  name      String       @unique // "vegetarian", "keto", "italian", "dinner", etc.
  type      TagType      @default(CUSTOM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  recipes   RecipeTag[] // Many-to-many relationship
  places    PlaceTag[]
  products  ProductTag[]

  @@index([name])
  @@index([type])
  @@index([deletedAt])
  @@map("tags")
}

// Junction table for many-to-many relationship between Recipe and Tag
model RecipeTag {
  id        String    @id @default(cuid(2))
  recipeId  String
  tagId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tagId])
  @@index([recipeId])
  @@index([tagId])
  @@index([deletedAt])
  @@map("recipe_tags")
}

model RecipeRating {
  id        String    @id @default(cuid(2))
  recipeId  String
  userId    String
  rating    Int // 1-5
  review    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([rating])
  @@index([deletedAt])
  @@map("recipe_ratings")
}

model RecipeFavorite {
  id        String    @id @default(cuid(2))
  recipeId  String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([deletedAt])
  @@map("recipe_favorites")
}

// ============================================
// PLACE MODELS
// ============================================

model Place {
  id                String             @id @default(cuid(2))
  slug              String             @unique
  name              String?
  shortName         String?
  description       String?            @db.Text
  type              PlaceType          @default(OTHER)
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  latitude          Decimal?           @db.Decimal(10, 8)
  longitude         Decimal?           @db.Decimal(11, 8)
  imageUrl          String?
  thumbnailUrl      String?
  videoUrl          String?
  sourceType        SourcePlatform     @default(MANUAL)
  sourceUrl         String?
  sourceName        String?
  sourceMetadata    Json?
  phoneNumber       String?
  website           String?
  priceRange        String?
  cuisine           String?
  hours             Json?
  rating            Decimal?           @db.Decimal(3, 2)
  notes             String?            @db.Text
  metadata          Json?
  userId            String?
  orgId             String?
  isPublic          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  tags              PlaceTag[]
  PlaceFavorite     PlaceFavorite[]
  chatConversations ChatConversation[]

  @@index([userId])
  @@index([orgId])
  @@index([type])
  @@index([city])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("places")
}

model PlaceTag {
  id        String    @id @default(cuid(2))
  placeId   String
  tagId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([placeId, tagId])
  @@index([placeId])
  @@index([tagId])
  @@index([deletedAt])
  @@map("place_tags")
}

model PlaceFavorite {
  id        String    @id @default(cuid(2))
  placeId   String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([placeId])
  @@index([userId])
  @@index([deletedAt])
  @@map("place_favorites")
}

// ============================================
// PRODUCT MODELS
// ============================================

model Product {
  id                String             @id @default(cuid(2))
  slug              String             @unique
  name              String?
  shortName         String?
  description       String?            @db.Text
  category          ProductCategory    @default(OTHER)
  brand             String?
  modelNumber       String?
  price             Decimal?           @db.Decimal(10, 2)
  currency          String?            @default("USD")
  imageUrl          String?
  thumbnailUrl      String?
  videoUrl          String?
  sourceType        SourcePlatform     @default(MANUAL)
  sourceUrl         String?
  sourceName        String?
  sourceMetadata    Json?
  purchaseUrl       String?
  affiliateUrl      String?
  specifications    Json?
  features          Json?
  notes             String?            @db.Text
  metadata          Json?
  userId            String?
  orgId             String?
  isPublic          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  tags              ProductTag[]
  ProductFavorite   ProductFavorite[]
  chatConversations ChatConversation[]

  @@index([userId])
  @@index([orgId])
  @@index([category])
  @@index([brand])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("products")
}

model ProductTag {
  id        String    @id @default(cuid(2))
  productId String
  tagId     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@index([deletedAt])
  @@map("product_tags")
}

model ProductFavorite {
  id        String    @id @default(cuid(2))
  productId String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([deletedAt])
  @@map("product_favorites")
}

// ============================================
// GROCERY & LIST MODELS
// ============================================

model GroceryList {
  id           String        @id @default(cuid(2))
  name         String
  description  String?
  userId       String
  orgId        String?
  completed    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  items        ListItem[]

  @@index([userId])
  @@index([orgId])
  @@index([completed])
  @@index([deletedAt])
  @@map("grocery_lists")
}

model ListItem {
  id           String              @id @default(cuid(2))
  listId       String
  ingredientId String?
  recipeId     String? // Track which recipe this came from
  name         String // In case ingredient doesn't exist
  amount       Decimal?            @db.Decimal(10, 2)
  unit         String?
  category     IngredientCategory?
  checked      Boolean             @default(false)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  list         GroceryList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe       Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([ingredientId])
  @@index([recipeId])
  @@index([checked])
  @@index([deletedAt])
  @@map("list_items")
}

// ============================================
// AI & USAGE MODELS
// ============================================

model AiUsage {
  id           String   @id @default(cuid(2))
  feature      String
  initiator    String
  provider     String
  model        String
  inputTokens  Float    @default(0) @map("input_tokens")
  outputTokens Float    @default(0) @map("output_tokens")
  userId       String   @map("user_id")
  recipeId     String?  @map("recipe_id")
  placeId      String?  @map("place_id")
  productId    String?  @map("product_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([recipeId])
  @@index([placeId])
  @@index([productId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([provider, model])
  @@map("ai_usages")
}

model DietaryPreference {
  id          String    @id @default(cuid(2))
  userId      String
  type        DietType
  allergens   Json? // Array of allergen strings
  dislikes    Json? // Array of disliked ingredients
  preferences Json? // Additional custom preferences
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([deletedAt])
  @@map("dietary_preferences")
}

// ============================================
// CHAT MODELS
// ============================================

model ChatConversation {
  id          String          @id @default(cuid(2))
  userId      String
  title       String?
  contextType ChatContextType @default(GENERAL)
  recipeId    String?
  placeId     String?
  productId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe      Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  place       Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages    ChatMessage[]

  @@index([userId])
  @@index([recipeId])
  @@index([placeId])
  @@index([productId])
  @@index([contextType])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid(2))
  conversationId String
  role           ChatRole
  content        String           @db.Text
  model          String? // AI model used
  tokens         Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================
// SUGGESTION & MEAL PLAN MODELS
// ============================================

model RecipeSuggestion {
  id        String    @id @default(cuid(2))
  userId    String
  recipeId  String
  reason    String? // Why this was suggested
  date      DateTime  @default(now())
  viewed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([date])
  @@index([viewed])
  @@index([deletedAt])
  @@map("recipe_suggestions")
}

model MealPlan {
  id        String           @id @default(cuid(2))
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes   MealPlanRecipe[]

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("meal_plans")
}

model MealPlanRecipe {
  id         String    @id @default(cuid(2))
  mealPlanId String
  recipeId   String
  date       DateTime
  mealType   MealType  @default(DINNER)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([recipeId])
  @@index([date])
  @@index([mealType])
  @@index([deletedAt])
  @@map("meal_plan_recipes")
}

// ============================================
// ENUMS
// ============================================

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  PAUSED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
