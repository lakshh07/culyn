generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  avatar             String?
  passwordHash       String?
  emailVerified      DateTime?
  provider           String?
  providerId         String?
  defaultOrgId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  organizations      UserOrganization[]
  dietaryPreferences DietaryPreference[]
  chatConversations  ChatConversation[]
  recipeSuggestions  RecipeSuggestion[]
  recipeRatings      RecipeRating[]
  favoritedRecipes   RecipeFavorite[]
  mealPlans          MealPlan[]
  Recipe             Recipe[]
  GroceryList        GroceryList[]

  @@index([email, id])
  @@index([deletedAt])
  @@map("users")
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logo           String?
  description    String?
  subscriptionId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  members      UserOrganization[]
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id])
  recipes      Recipe[]
  lists        GroceryList[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model UserOrganization {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([deletedAt])
  @@map("user_organizations")
}

model Subscription {
  id                     String             @id @default(cuid())
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  maxRecipes             Int                @default(50)
  maxUsers               Int                @default(1)
  maxLists               Int                @default(5)
  aiCreditsLimit         Int                @default(100)
  aiCreditsUsed          Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  organization           Organization?

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([deletedAt])
  @@map("subscriptions")
}

// ============================================
// RECIPE MODELS
// ============================================

model Recipe {
  id              String             @id @default(cuid())
  title           String
  description     String?
  imageUrl        String?
  prepTime        Int?
  cookTime        Int?
  servings        Int?
  difficulty      RecipeDifficulty?
  instructions    Json // Array of steps
  notes           String?
  sourceType      RecipeSourceType   @default(MANUAL)
  sourceUrl       String?
  sourceName      String?
  calories        Int?
  protein         Decimal?           @db.Decimal(10, 2)
  carbs           Decimal?           @db.Decimal(10, 2)
  fat             Decimal?           @db.Decimal(10, 2)
  userId          String?
  orgId           String?
  isPublic        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization    Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  ingredients     RecipeIngredient[]
  tags            RecipeTag[]
  ratings         RecipeRating[]
  favorites       RecipeFavorite[]
  suggestions     RecipeSuggestion[]
  mealPlanRecipes MealPlanRecipe[]
  listItems       ListItem[]

  @@index([userId])
  @@index([orgId])
  @@index([sourceType])
  @@index([isPublic])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recipes")
}

model Ingredient {
  id          String              @id @default(cuid())
  name        String              @unique
  category    IngredientCategory?
  calories    Int?
  protein     Decimal?            @db.Decimal(10, 2)
  carbs       Decimal?            @db.Decimal(10, 2)
  fat         Decimal?            @db.Decimal(10, 2)
  commonUnits Json? // Array of common units like "cup", "tbsp", "g"
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  recipes     RecipeIngredient[]
  listItems   ListItem[]

  @@index([name])
  @@index([category])
  @@index([deletedAt])
  @@map("ingredients")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Decimal?   @db.Decimal(10, 2)
  unit         String? // "cup", "tbsp", "g", etc.
  preparation  String? // "chopped", "diced", "minced"
  optional     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([deletedAt])
  @@map("recipe_ingredients")
}

model RecipeTag {
  id        String    @id @default(cuid())
  recipeId  String
  tag       String // "vegetarian", "keto", "italian", "dinner", etc.
  type      TagType   @default(CUSTOM)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tag])
  @@index([recipeId])
  @@index([tag])
  @@index([type])
  @@index([deletedAt])
  @@map("recipe_tags")
}

model RecipeRating {
  id        String    @id @default(cuid())
  recipeId  String
  userId    String
  rating    Int // 1-5
  review    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([rating])
  @@index([deletedAt])
  @@map("recipe_ratings")
}

model RecipeFavorite {
  id        String    @id @default(cuid())
  recipeId  String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([deletedAt])
  @@map("recipe_favorites")
}

model GroceryList {
  id           String        @id @default(cuid())
  name         String
  description  String?
  userId       String
  orgId        String?
  completed    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  items        ListItem[]

  @@index([userId])
  @@index([orgId])
  @@index([completed])
  @@index([deletedAt])
  @@map("grocery_lists")
}

model ListItem {
  id           String              @id @default(cuid())
  listId       String
  ingredientId String?
  recipeId     String? // Track which recipe this came from
  name         String // In case ingredient doesn't exist
  amount       Decimal?            @db.Decimal(10, 2)
  unit         String?
  category     IngredientCategory?
  checked      Boolean             @default(false)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  list         GroceryList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe       Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([ingredientId])
  @@index([recipeId])
  @@index([checked])
  @@index([deletedAt])
  @@map("list_items")
}

model DietaryPreference {
  id          String    @id @default(cuid())
  userId      String
  type        DietType
  allergens   Json? // Array of allergen strings
  dislikes    Json? // Array of disliked ingredients
  preferences Json? // Additional custom preferences
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([deletedAt])
  @@map("dietary_preferences")
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  recipeId  String? // If chat is about a specific recipe
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@index([recipeId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String           @db.Text
  model          String? // AI model used
  tokens         Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("chat_messages")
}

model RecipeSuggestion {
  id        String    @id @default(cuid())
  userId    String
  recipeId  String
  reason    String? // Why this was suggested
  date      DateTime  @default(now())
  viewed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([date])
  @@index([viewed])
  @@index([deletedAt])
  @@map("recipe_suggestions")
}

model MealPlan {
  id        String           @id @default(cuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes   MealPlanRecipe[]

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("meal_plans")
}

model MealPlanRecipe {
  id         String    @id @default(cuid())
  mealPlanId String
  recipeId   String
  date       DateTime
  mealType   MealType  @default(DINNER)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([recipeId])
  @@index([date])
  @@index([mealType])
  @@index([deletedAt])
  @@map("meal_plan_recipes")
}

// ============================================
// ENUMS
// ============================================

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  PAUSED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeSourceType {
  MANUAL // User created
  IMPORTED // Imported from URL
  AI_GENERATED
  COMMUNITY // From public recipes
}

enum IngredientCategory {
  PRODUCE
  MEAT
  SEAFOOD
  DAIRY
  BAKERY
  PANTRY
  SPICES
  CONDIMENTS
  FROZEN
  BEVERAGES
  OTHER
}

enum TagType {
  CUISINE // Italian, Mexican, Asian, etc.
  MEAL_TYPE // Breakfast, Lunch, Dinner, Snack, Dessert
  DIET // Vegetarian, Vegan, Keto, Paleo, etc.
  SEASON // Summer, Winter, Fall, Spring
  OCCASION // Holiday, Party, Quick, Comfort
  CUSTOM // User-defined tags
}

enum DietType {
  VEGETARIAN
  VEGAN
  KETO
  PALEO
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  LOW_CARB
  LOW_FAT
  HALAL
  KOSHER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
}
